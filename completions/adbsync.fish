# Fish completion for adbsync.
# Generated by `adbsync completion fish` -- do not edit by hand;
# regenerate it after changing the CLI.

# Parse the current command line; prints "SUBCOMMAND;POSITIONALS_COMPLETED" on
# the first line followed by any adb options typed so far, one per line.
function __adbsync_parse
    set -l tokens (commandline -opc)
    set -e tokens[1] # drop the command name itself
    set -l sub ''
    set -l npos 0
    set -l adb_args
    set -l skip 0
    set -l i 1
    set -l n (count $tokens)
    while test $i -le $n
        set -l token $tokens[$i]
        if test $skip -gt 0
            set skip (math $skip - 1)
        else
            switch $token
                case '--adb-bin' '--adb-flag'
                    if test $i -lt $n
                        set -a adb_args $token $tokens[(math $i + 1)]
                        set skip 1
                    end
                case '--adb-option'
                    if test (math $i + 1) -le $n
                        set -a adb_args $token $tokens[(math $i + 1)] $tokens[(math $i + 2)]
                        set skip 2
                    end
                case '--exclude' '--exclude-from' '--adb-encoding'
                    set skip 1
                case '--*' '-*' # valueless flags, incl. -h/--help
                case '*'
                    if test -z "$sub"
                        set sub $token
                    else
                        set npos (math $npos + 1)
                    end
            end
        end
        set i (math $i + 1)
    end
    printf '%s;%s\n' "$sub" "$npos"
    for adb_arg in $adb_args
        printf '%s\n' "$adb_arg"
    end
end

# Refresh the global scratch variables _adbsync_sub, _adbsync_npos and
# _adbsync_adb_args for the current command line.
function __adbsync_state
    set -l lines (__adbsync_parse)
    set -l info (string split -m 1 ';' -- $lines[1])
    set -g _adbsync_sub $info[1]
    set -g _adbsync_npos $info[2]
    set -g _adbsync_adb_args
    if test (count $lines) -gt 1
        set -g _adbsync_adb_args $lines[2..-1]
    end
end

# True while completing a local path argument (push's 1st, pull's 2nd).
function __adbsync_is_local
    __adbsync_state
    if test "$_adbsync_sub" = push
        test "$_adbsync_npos" = 0
    else if test "$_adbsync_sub" = pull
        test "$_adbsync_npos" = 1
    else
        return 1
    end
end

# True while completing a remote (Android) path argument (push's 2nd, pull's
# 1st).
function __adbsync_is_remote
    __adbsync_state
    if test "$_adbsync_sub" = push
        test "$_adbsync_npos" = 1
    else if test "$_adbsync_sub" = pull
        test "$_adbsync_npos" = 0
    else
        return 1
    end
end

# True while completing the SHELL argument of the completion subcommand.
function __adbsync_is_completion_shell
    __adbsync_state
    test "$_adbsync_sub" = completion
    and test "$_adbsync_npos" = 0
end

# List the immediate children of a remote (Android) directory (directories are
# suffixed with "/" by the helper). Helper errors and its internal timeout are
# swallowed: an empty result simply means "no completions".
function __adbsync_remote_paths
    __adbsync_state
    set -l cur (commandline -ct)
    set -l parent
    if string match -q '*/*' -- $cur
        set parent (string replace -r '/[^/]*$' '' -- $cur)
    end
    if test -z "$parent"
        set parent /
        set prefix /
    else if test "$parent" = /
        set prefix /
    else
        set prefix $parent/
    end
    for entry in (adbsync $_adbsync_adb_args completion-remote-paths $parent 2>/dev/null)
        printf '%s\n' "$prefix$entry"
    end
end

# Disable file completion by default; it is re-enabled for local arguments.
complete -c adbsync -f

# Subcommands
complete -c adbsync -n '__fish_use_subcommand' -a push -d 'Push from computer to phone'
complete -c adbsync -n '__fish_use_subcommand' -a pull -d 'Pull from phone to computer'
complete -c adbsync -n '__fish_use_subcommand' -a completion -d 'Print a shell completion script (bash, zsh or fish) to stdout'

# Global options (accepted only before the subcommand, like argparse)
complete -c adbsync -n '__fish_use_subcommand' -s h -l help -d 'show this help message and exit'
complete -c adbsync -n '__fish_use_subcommand' -l version -d 'show programs version number and exit'
complete -c adbsync -n '__fish_use_subcommand' -l no-color -d 'Disable colored logging (Linux only)'
complete -c adbsync -n '__fish_use_subcommand' -s v -l verbose -d 'Increase logging verbosity: -v for debug'
complete -c adbsync -n '__fish_use_subcommand' -s q -l quiet -d 'Decrease logging verbosity: -q for warning, -qq for error, -qqq for critical, -qqqq for no logging messages'
complete -c adbsync -n '__fish_use_subcommand' -s n -l dry-run -d 'Perform a dry run; do not actually copy and delete etc'
complete -c adbsync -n '__fish_use_subcommand' -s L -l copy-links -d 'Follow symlinks and copy their referent file / directory'
complete -c adbsync -n '__fish_use_subcommand' -l exclude -r -d 'fnmatch pattern to ignore relative to source (reusable)'
complete -c adbsync -n '__fish_use_subcommand' -l exclude-from -r -d 'Filename of file containing fnmatch patterns to ignore relative to source (reusable)'
complete -c adbsync -n '__fish_use_subcommand' -l del -d 'Delete files at the destination that are not in the source'
complete -c adbsync -n '__fish_use_subcommand' -l delete-excluded -d 'Delete files at the destination that are excluded'
complete -c adbsync -n '__fish_use_subcommand' -l force -d 'Allows files to overwrite folders and folders to overwrite files. This is false by default to prevent large scale accidents'
complete -c adbsync -n '__fish_use_subcommand' -l show-progress -d 'Show progress from adb push and adb pull commands'
complete -c adbsync -n '__fish_use_subcommand' -l adb-encoding -r -d 'Which encoding to use when talking to adb. Defaults to UTF-8. Relevant to GitHub issue https://github.com/jb2170/better-adb-sync/issues/22'
complete -c adbsync -n '__fish_use_subcommand' -l adb-bin -r -d 'Use the given adb binary. Defaults to adb ie whatever is on path'
complete -c adbsync -n '__fish_use_subcommand' -l adb-flag -r -d 'Add a flag to call adb with, eg --adb-flag d for adb -d, that is return an error if more than one device is connected'
complete -c adbsync -n '__fish_use_subcommand' -l adb-option -r -d 'Add an option to call adb with, eg --adb-option P 5037 for adb -P 5037, that is use port 5037 for the adb server'
complete -c adbsync -n '__fish_use_subcommand' -l skip-permission-denied -d 'If folders on Android are not accessible because of folder permission ignore this and continue'

# Positional arguments: local paths get native file completion, remote paths
# are listed by the internal helper, and the completion subcommand takes the
# shell names.
complete -c adbsync -n '__adbsync_is_local' -F
complete -c adbsync -n '__adbsync_is_remote' -a '(__adbsync_remote_paths)'
complete -c adbsync -n '__adbsync_is_completion_shell' -a 'bash zsh fish'
