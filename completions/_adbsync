#compdef adbsync
# Zsh completion for adbsync.
# Generated by `adbsync completion zsh` -- do not edit by hand;
# regenerate it after changing the CLI.

# List the immediate children of a remote (Android) directory (directories are
# suffixed with "/" by the helper). Helper errors and its internal timeout are
# swallowed: an empty result simply means "no completions". Relies on the
# dynamically scoped $adb_args set up by _adbsync below.
_adbsync_remote() {
    local parent prefix
    if [[ "$PREFIX" != */* ]]; then
        parent=""
        prefix=""
    else
        parent="${PREFIX:h}"
        if [[ "$parent" == "/" ]]; then
            prefix="/"
        else
            prefix="${parent}/"
        fi
    fi
    local -a entries candidates
    entries=("${(@f)$(adbsync ${adb_args[@]+"${adb_args[@]}"} completion-remote-paths "${parent:-/}" 2>/dev/null)}")
    local entry
    for entry in "${entries[@]}"; do
        [[ -n "$entry" ]] || continue
        candidates+=("${prefix}${entry}")
    done
    compadd -Q -a candidates
}

_adbsync() {
    # Collect the adb options typed so far so remote path queries honor
    # --adb-bin/--adb-flag/--adb-option.
    local w
    local -a adb_args
    local -i i=2
    while (( i < CURRENT )); do
        w="${words[i]}"
        case "$w" in
            --adb-bin|--adb-flag)
                if (( i + 1 < CURRENT )); then
                    adb_args+=("$w" "${words[i+1]}")
                    i=$(( i + 1 ))
                fi
                ;;
            --adb-option)
                if (( i + 2 < CURRENT )); then
                    adb_args+=("$w" "${words[i+1]}" "${words[i+2]}")
                    i=$(( i + 2 ))
                fi
                ;;
        esac
        i=$(( i + 1 ))
    done

    local context state state_descr line
    typeset -A opt_args

    _arguments -C \
        '-h[show this help message and exit]' \
        '--help[show this help message and exit]' \
        '--version[show programs version number and exit]' \
        '--no-color[Disable colored logging (Linux only)]' \
        '-v[Increase logging verbosity - -v for debug]' \
        '--verbose[Increase logging verbosity - -v for debug]' \
        '-q[Decrease logging verbosity - -q for warning, -qq for error, -qqq for critical, -qqqq for no logging messages]' \
        '--quiet[Decrease logging verbosity - -q for warning, -qq for error, -qqq for critical, -qqqq for no logging messages]' \
        '-n[Perform a dry run; do not actually copy and delete etc]' \
        '--dry-run[Perform a dry run; do not actually copy and delete etc]' \
        '-L[Follow symlinks and copy their referent file / directory]' \
        '--copy-links[Follow symlinks and copy their referent file / directory]' \
        '--exclude[fnmatch pattern to ignore relative to source (reusable)]:EXCLUDE: ' \
        '--exclude-from[Filename of file containing fnmatch patterns to ignore relative to source (reusable)]:EXCLUDE_FROM:_files' \
        '--del[Delete files at the destination that are not in the source]' \
        '--delete-excluded[Delete files at the destination that are excluded]' \
        '--force[Allows files to overwrite folders and folders to overwrite files. This is false by default to prevent large scale accidents]' \
        '--show-progress[Show progress from adb push and adb pull commands]' \
        '--adb-encoding[Which encoding to use when talking to adb. Defaults to UTF-8. Relevant to GitHub issue https -//github.com/jb2170/better-adb-sync/issues/22]:ADB_ENCODING: ' \
        '--adb-bin[Use the given adb binary. Defaults to adb ie whatever is on path]:ADB_BIN:_files' \
        '--adb-flag[Add a flag to call adb with, eg --adb-flag d for adb -d, that is return an error if more than one device is connected]:ADB_FLAG: ' \
        '--adb-option[Add an option to call adb with, eg --adb-option P 5037 for adb -P 5037, that is use port 5037 for the adb server]:OPTION: :VALUE: ' \
        '--skip-permission-denied[If folders on Android are not accessible because of folder permission ignore this and continue]' \
        '1: :->subcommand' \
        '*:: :->args' \
        && return 0

    case $state in
        subcommand)
            local -a subcommands
            subcommands=(push pull completion)
            _describe -t subcommands 'adbsync command' subcommands
            ;;
        args)
            case "${words[1]}" in
                push)
                    _arguments \
                        '1:local path:_files' \
                        '2:android path:_adbsync_remote'
                    ;;
                pull)
                    _arguments \
                        '1:android path:_adbsync_remote' \
                        '2:local path:_files'
                    ;;
                completion)
                    _arguments \
                        '1:shell:(bash zsh fish)'
                    ;;
            esac
            ;;
    esac
}

_adbsync "$@"
